# N8N Configuration for Render Deployment
N8N_PORT=5678
PORT=5678
N8N_PROTOCOL=https
N8N_ENCRYPTION_KEY=replace_with_a_secure_random_string_32_chars
GENERIC_TIMEZONE=America/New_York
WEBHOOK_URL=https://your-n8n-app.onrender.com/

# Data Pruning (keeps disk healthy)
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168

# Django Backend API Endpoint
DJANGO_BACKEND_URL=https://your-django-app.vercel.app/api/
DJANGO_API_TOKEN=your_secure_django_api_token
